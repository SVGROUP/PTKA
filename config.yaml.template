# PT 保活服务配置文件
# ⚠️ 本文件由模板 config.yaml.template 自动生成，请按需修改后重启容器生效。
# 持久化路径：容器内 ./config/config.yaml（对应宿主挂载的 config 目录）

# 服务端口
port: 50002

# 定时任务 cron 表达式 (UTC 时区)
# 默认: 每天 UTC 1 点 = 北京时间 9 点
schedule: "0 1 * * *"

# SQLite 数据库文件路径
database_path: "./data/pt-keepalive.db"

# 飞书自定义机器人 webhook（用于 Watchtower 镜像更新通知转发，留空则禁用）
# Watchtower 通知 URL 指向: generic://<本机IP>:50002/api/notify/feishu?disabletls=yes
feishu_webhook: ""
# 飞书机器人如开了“自定义关键词”安全验证，把其中一个关键词填这里，发送时会自动带上；留空不带
feishu_keyword: ""

# Watchtower 人工触发升级（watchtower-trigger 实例的 HTTP API）
# 页面点“升级”时 PTKA 会调 <url>/v1/update?images=<容器名>
watchtower_api_url: ""          # 如 http://127.0.0.1:50004
watchtower_api_token: ""        # 与 watchtower-trigger 的 WATCHTOWER_HTTP_API_TOKEN 一致

# 升级页面展示的“手动检查一次”命令模板（留空则后端自动生成）
# 自动生成的命令带 --run-once --monitor-only --no-startup-message --notification-report：
#   只扫描不升级、不发开机横幅、结果汇总成一条结构化报告便于 PTKA 入库
# {host} / {port} 占位符会被替换为当前访问主机和 PTKA 端口
watchtower_check_cmd: ""

# 检查镜像时用的 HTTP 代理（Docker Hub 被墙时必需，填了页面命令会自动带 -e HTTP_PROXY/-e HTTPS_PROXY）
# 同时自动带 -e NO_PROXY 排除内网/本机，避免发往 PTKA 的通知也走代理导致收不到
# 如 http://10.0.4.20:7890（指向你的代理），留空则不加代理
watchtower_proxy: ""

# 默认站点配置（初始化数据库时使用）
# 初始化后可通过网页界面管理配置，修改此处不会更新已创建的配置
sites:
  13city:
    enabled: true
    cookies: ""
  52pt:
    enabled: true
    cookies: ""
  audiences:
    enabled: true
    cookies: ""
